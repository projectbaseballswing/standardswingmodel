# Copy to .env. Never commit real credentials.
# Supabase Connect: Direct connection or Session pooler (5432).
# Use postgresql+psycopg:// and append ?sslmode=require; URL-encode the password.
DATABASE_URL=
# Existing team accounts/analyses use public. Select an isolated schema only
# for explicitly approved staging. Never copy users between schemas.
SWING_DATABASE_SCHEMA=public
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=swing-videos
SUPABASE_SIGNED_URL_SECONDS=900
SWING_STORAGE_BACKEND=supabase
SWING_SESSION_TTL_SECONDS=28800
# Local development only; a private project/OS-temp subdirectory, never served
# as static files. Empty by default, so production cannot silently use disk.
SWING_LOCAL_STORAGE_ROOT=
# Development default. Deployment must supply exact frontend origins, comma separated.
SWING_CORS_ORIGINS=*

# Mock skips model inference ONLY; DB and Storage are still real.
SWING_MOCK=0
SWING_MAX_UPLOAD_MB=200
# Stable and unique for each server/PC sharing the DB. Empty = hostname.
# Run only one uvicorn process per worker ID.
SWING_WORKER_ID=

# LLM coaching (OpenAI). Empty key = skip LLM, use rule-based fallback.
# gpt-6-luna: coaching is short structured JSON, so the small/fast model is enough.
# Bump OPENAI_MODEL (e.g. gpt-6.1-terra) if Korean coaching nuance falls short.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
